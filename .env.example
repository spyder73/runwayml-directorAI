# Required for production BYOK storage.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Optional private media storage override. Defaults to data/media.
# MEDIA_STORAGE_DIR=/app/data/media

# Runway generation
# gen4_turbo is the default; veo3.1_fast outputs 1920x1080 / 1080x1920 clips.
RUNWAY_VIDEO_MODEL=gen4_turbo

# Runway Character voice interview
# RUNWAY_CHARACTER_AVATAR_ID=
# RUNWAY_CHARACTER_API_SECRET=
# RUNWAY_CHARACTER_SESSION_READY_TIMEOUT_MS=60000
# AVATAR_DEBUG_LOGS=1

# Final Remotion render quality
# fast: 960x540 / 540x960, CRF 28, superfast preset.
# standard: 1280x720 / 720x1280, CRF 20, veryfast preset.
# ultra: 1920x1080 / 1080x1920, CRF 18, veryfast preset.
REMOTION_RENDER_QUALITY=fast

# Optional Remotion render tuning
# Examples: 50%, 75%, 100%, or a number such as 4.
REMOTION_CONCURRENCY=50%
REMOTION_TIMEOUT_MS=900000
# Override preset or CRF only when intentionally benchmarking.
REMOTION_X264_PRESET=veryfast
# REMOTION_CRF=20
REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
# CHROME_BIN=
# REMOTION_ENTRY_POINT=
REMOTION_BUNDLE_CACHE=true

# Optional diagnostics
# MEDIA_GENERATION_LOGS=1
