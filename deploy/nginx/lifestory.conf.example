# Put the limit_req_zone directives in the nginx http {} context.
limit_req_zone $binary_remote_addr zone=lifestory_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=lifestory_upload:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=lifestory_generation:10m rate=20r/m;

server {
  listen 80;
  server_name your-new-domain.com www.your-new-domain.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name your-new-domain.com www.your-new-domain.com;

  client_max_body_size 25m;

  location /api/auth/ {
    limit_req zone=lifestory_auth burst=10 nodelay;
    proxy_pass http://lifestory-web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 900s;
  }

  location /api/pipeline/upload {
    limit_req zone=lifestory_upload burst=20 nodelay;
    proxy_pass http://lifestory-web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 900s;
  }

  location ~ ^/api/pipeline/(start|demo|outline|synthesize|retry|render) {
    limit_req zone=lifestory_generation burst=30 nodelay;
    proxy_pass http://lifestory-web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 900s;
  }

  location /api/pipeline/events {
    proxy_pass http://lifestory-web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }

  location / {
    proxy_pass http://lifestory-web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 900s;
  }
}
